# Database configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crypto_trading

# Or full database connection URL (overrides individual DB_* settings above)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/crypto_trading

# JWT Secret Key
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# Flask configuration
FLASK_APP=app:create_app
FLASK_ENV=development
FLASK_DEBUG=1
